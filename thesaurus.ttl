<https://homernetwork.github.io/vocabulary/identifiers/> a skos:ConceptScheme;
  dct:title "Identifiers"@en;
  skos:hasTopConcept identifiers:Cinema_Context_ID, identifiers:IMDb_ID, identifiers:Location_Point,
    identifiers:Wikidata_ID .

identifiers:Cinema_Context_ID a skos:Concept;
  skos:definition "ID of the movie in Cinema Context"@en;
  skos:inScheme <https://homernetwork.github.io/vocabulary/identifiers/>;
  skos:prefLabel "Cinema Context ID"@en;
  skos:topConceptOf <https://homernetwork.github.io/vocabulary/identifiers/> .

identifiers:IMDb_ID a skos:Concept;
  skos:definition "IMDb ID without TT or leading zeroes."@en;
  skos:inScheme <https://homernetwork.github.io/vocabulary/identifiers/>;
  skos:prefLabel "IMDb ID"@en;
  skos:topConceptOf <https://homernetwork.github.io/vocabulary/identifiers/> .

identifiers:Location_Point a skos:Concept;
  skos:definition "Latitude and longitude"@en;
  skos:inScheme <https://homernetwork.github.io/vocabulary/identifiers/>;
  skos:prefLabel "Location Point"@en;
  skos:topConceptOf <https://homernetwork.github.io/vocabulary/identifiers/> .

identifiers:Wikidata_ID a skos:Concept;
  skos:definition "ID of the movie in Wikidata"@en;
  skos:inScheme <https://homernetwork.github.io/vocabulary/identifiers/>;
  skos:prefLabel "Wikidata ID"@en;
  skos:topConceptOf <https://homernetwork.github.io/vocabulary/identifiers/> .

<https://homernetwork.github.io/vocabulary/rooms/> a skos:ConceptScheme;
  dct:title "Rooms"@en;
  skos:hasTopConcept subvenue:Room .

subvenue:Room a skos:Concept;
  skos:definition "Subdivision of venue, equipped with a screen and a projector for viewing movies."@en;
  skos:inScheme <https://homernetwork.github.io/vocabulary/rooms/>;
  skos:narrower subvenue:Home_cinema, subvenue:Screening_room;
  skos:prefLabel "Room"@en;
  skos:topConceptOf <https://homernetwork.github.io/vocabulary/rooms/> .

subvenue:Home_cinema a skos:Concept;
  skos:broader subvenue:Room;
  skos:definition "a specific area within a house furnished with the essential equipment for enjoying cinematic works. These spaces emulate the atmosphere of public cinemas while being located within a private home."@en;
  skos:inScheme <https://homernetwork.github.io/vocabulary/rooms/>;
  skos:prefLabel "Home cinema"@en .

subvenue:Screening_room a skos:Concept;
  skos:broader subvenue:Room;
  skos:definition "A screening room is a facility equipped with a screen and a projector for viewing movies."@en;
  skos:inScheme <https://homernetwork.github.io/vocabulary/rooms/>;
  skos:prefLabel "Auditorium"@sv, "Screening room"@en, "sala di proiezione"@it .
