<https://homernetwork.github.io/vocabulary/events/> a skos:ConceptScheme;
  dct:description "Events, such as programming, screenings and film festivals"@en;
  dct:license <https://creativecommons.org/licenses/by/4.0/>;
  dct:title "Film related events"@en .

<https://homernetwork.github.io/vocabulary/organizations/> dct:description "Film-related organization types refers to the diverse range of formal entities (government-led, commercial, or non-profit, etc.) that facilitate the creation, distribution, preservation, and regulation of moving images."@en;
  dct:license <https://creativecommons.org/licenses/by/4.0/>;
  dct:title "Film-related organization types"@en .

organizations:Public_organization a skos:Concept;
  skos:prefLabel "Public organization"@en .

organizations:Private_organization a skos:Concept;
  skos:prefLabel "Private organization"@en .

organizations:Informal_organization a skos:Concept;
  skos:definition "Informal organizations usually don't have a true legal status and are usually less organized than cooperative organizations."@en;
  skos:example "Film clubs and other communities that engage in film related activities"@en;
  skos:prefLabel "Informal organization"@en .

organizations:State_agency a skos:Concept;
  skos:broader organizations:Public_organization;
  skos:example "Ministry, departments, agencies and their local ramifications (such as prefectures for the Italian ministry of the Interior)"@en;
  skos:prefLabel "State agency"@en .

organizations:Local_authority a skos:Concept;
  skos:broader organizations:Public_organization;
  skos:example "Councils, counties, provinces and municipalities. Usually chosen by or influenced by local bodies."@en;
  skos:prefLabel "Local authority"@en .

organizations:Sole_proprietorship a skos:Concept;
  skos:broader organizations:Private_organization;
  skos:prefLabel "Sole proprietorship"@en .

organizations:Partnership a skos:Concept;
  skos:broader organizations:Private_organization;
  skos:prefLabel "Partnership"@en .

organizations:Corporation a skos:Concept;
  skos:broader organizations:Private_organization;
  skos:prefLabel "Corporation"@en .

organizations:Cooperative a skos:Concept;
  skos:broader organizations:Private_organization;
  skos:definition <https://en.wikipedia.org/wiki/Cooperative>;
  skos:prefLabel "Cooperative"@en .

organizations:Association a skos:Concept;
  skos:broader organizations:Private_organization;
  skos:example "Film societies, ..."@en;
  skos:prefLabel "Association"@en .

organizations:Military_organization a skos:Concept;
  skos:broader organizations:State_agency;
  skos:definition "Can have subdivisions: regiments, units, etc."@en;
  skos:prefLabel "Military organization"@en .

organizations:NGO a skos:Concept;
  skos:definition "Organizations independent from the state: https://en.wikipedia.org/wiki/Non-governmental_organization"@en;
  skos:prefLabel "NGO"@en .

organizations:Organizations_by_goal a skos:Concept;
  skos:narrower organizations:Commercial_organization, organizations:Confessional_organization,
    organizations:Educational_organization, organizations:Political_organization, organizations:Professional_organization,
    organizations:Recreational_organization, organizations:Security_organization;
  skos:prefLabel "Organizations by goal"@en .

organizations:Educational_organization a skos:Concept;
  skos:broader organizations:Organizations_by_goal;
  skos:prefLabel "Educational organization"@en .

organizations:Commercial_organization a skos:Concept;
