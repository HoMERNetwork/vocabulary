  skos:definition "Foteini Klini - audience that is learning how to watch film"@en;
  skos:prefLabel "training"@en .

audiences:civilian skos:broader audiences:audience_per_civic_status;
  skos:definition "Foteini Klini"@en;
  skos:prefLabel "civilian"@en .

audiences:tourists skos:broader audiences:audience_per_civic_status;
  skos:definition "David morton,Monique Toppin-"@en;
  skos:prefLabel "tourists"@en .

audiences:academics skos:definition "David morton"@en;
  skos:prefLabel "academics"@en .

audiences:peasants skos:definition "Foteini Klini"@en;
  skos:prefLabel "peasants"@en .

audiences:American_negro skos:broader audiences:audience_by_cultural_makeup;
  skos:definition "Kristina Tanis"@en;
  skos:prefLabel "American negro"@en .

audiences:Irish_migrants skos:broader audiences:audience_by_cultural_makeup;
  skos:definition "Frank Mannion"@en;
  skos:prefLabel "Irish migrants"@en .

