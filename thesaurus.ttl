  skos:example "Churches and Parishes"@en;
  skos:prefLabel "Confessional organization"@en .

organizations:Recreational_organization a skos:Concept;
  skos:broader organizations:Organizations_by_goal;
  skos:prefLabel "Recreational organization"@en .

organizations:Professional_organization a skos:Concept;
  skos:broader organizations:Organizations_by_goal;
  skos:prefLabel "Professional organization"@en .

organizations:Political_organization a skos:Concept;
