{"id":"https://homernetwork.github.io/vocabulary/venues/","type":"ConceptScheme","title":{"en":"Venues"},"description":{"en":"Terms to describe venues."},"license":{"id":"https://creativecommons.org/licenses/by/4.0/"},"hasTopConcept":[{"id":"https://homernetwork.github.io/vocabulary/venues/Venue","prefLabel":{"en":"Venue","fr":"Salle de cinéma","sv":"Biograf"},"altLabel":{"fr":["Salle obscure"],"nl":["bioscoop","plaats","theater","zaal"]},"definition":{"en":"A place"},"narrower":[{"id":"https://homernetwork.github.io/vocabulary/venues/Public_venue","prefLabel":{"en":"Public venue","nl":"openbare ruimte"},"definition":{"en":"A venue open to everyone"},"narrower":[{"id":"https://homernetwork.github.io/vocabulary/venues/Kommunales_Kino","prefLabel":{"en":"Kommunales Kino","de":"Kommunales Kino"},"altLabel":{"de":["Kommunales Kino"]},"definition":{"en":"Cinema financed by a municipality, non-commercial, dedicated to art cinema and retrospectives of classics and other historically relevant films"}},{"id":"https://homernetwork.github.io/vocabulary/venues/Art_house_cinema","prefLabel":{"en":"Art house cinema","nl":"Filmhuis","de":"Programmkino"},"definition":{"en":"Art cinema, sometimes with financial support by the municipality"}},{"id":"https://homernetwork.github.io/vocabulary/venues/Multiplex","prefLabel":{"en":"Multiplex","sv":"Filmstaden","it":"multisala"},"altLabel":{"en":["Multi-screen cinema"]},"definition":{"en":"A multiplex is a facility that accommodates multiple screens for the simultaneous screening of films."},"narrower":[{"id":"https://homernetwork.github.io/vocabulary/venues/Cityplex","prefLabel":{"en":"Cityplex"},"definition":{"en":"4-7 screens close to city centre"},"scopeNote":{"en":["Italy?"]}},{"id":"https://homernetwork.github.io/vocabulary/venues/Proto-multiplex","prefLabel":{"en":"Proto-multiplex"},"definition":{"en":"odeon cannon Roma or Milan?1986. includes food, shops etc, that stay open at night?"},"scopeNote":{"en":["Italy"]}},{"id":"https://homernetwork.github.io/vocabulary/venues/Italian_Multiplex","prefLabel":{"en":"Italian Multiplex"},"definition":{"en":"at least 8 screens, other measure activities that stay open till night (food, shops). eg Arcadia, Ostia"},"scopeNote":{"en":["Italy"]}},{"id":"https://homernetwork.github.io/vocabulary/venues/sachelskino?","prefLabel":{"en":"sachelskino?"},"definition":{"en":"monoscteen 1k seats divided into multiple screens germ 70s"}},{"id":"https://homernetwork.github.io/vocabulary/venues/inbouwbioscoop","prefLabel":{"en":"inbouwbioscoop"},"definition":{"en":"Een belangrijke ontwikkeling tenslotte is de inbouwbioscoop, die sinds 1971 sterk in\nopkomst is: grote bioscoopgebouwen worden opgesplitst in afzonderlijke zalen en zaaltjes,\nzodat er allerlei drie-in-een en vier-in-een theaters ontstaan.","fr":"thunnis, dibbets"}}]},{"id":"https://homernetwork.github.io/vocabulary/venues/Open-air","prefLabel":{"en":"Open-air","nl":"open lucht"},"altLabel":{"en":["Open-air"]},"definition":{"en":"It can be a square, a courtyard, a field. source: Europeancinemaaudiences.org"},"narrower":[{"id":"https://homernetwork.github.io/vocabulary/venues/Open-air_cinema","prefLabel":{"en":"Open-air cinema","nl":"openluchtbioscoop","sv":"Utomhusbio","es":"Terraza"},"altLabel":{"en":["Arena"]},"definition":{"en":"An open air or outdoor cinema, often temporary"},"narrower":[{"id":"https://homernetwork.github.io/vocabulary/venues/Drive-in_cinema","prefLabel":{"en":"Drive-in cinema","nl":"drive-in bioscoop","de":"Autokino"},"altLabel":{"en":["Drive-in cinema"],"de":["Autokino"]},"definition":{"en":"Drive-ins are outdoor venues where audiences watch movies from their own vehicles. These locations provide all the necessary screening facilities for enjoying films."}},{"id":"https://homernetwork.github.io/vocabulary/venues/cinema_with_retractable_roof","prefLabel":{"en":"cinema with retractable roof"},"definition":{"fr":"François Beaurain- ENSA Paris la Villette)"}}]}]},{"id":"https://homernetwork.github.io/vocabulary/venues/Folkets_Hus_Biografer","prefLabel":{"en":"Folkets Hus Biografer","sv":"Folkets Hus Biografer"},"altLabel":{"sv":["Folkbiografer","Folkets bio"]},"definition":{"en":"Cinemas driven by temperence societies and other independent cinemas and a smaller number of other kinds of grassroots organisations, such as local youth and sports clubs. This kind of ownership could involve a single cinema or a chain of cinemas."}},{"id":"https://homernetwork.github.io/vocabulary/venues/Biograf","prefLabel":{"en":"Biograf","sv":"Biograf"},"definition":{"en":"a venue, usually a building, for viewing films that has been listed by film companies (also known as 'cinemas' in the Swedish industry records, ie Filmägarnas kontrollbyrå) for more or less regular exhibition of film. It is a geographically fixed (with a street address) building. The frequency of film exhibition in a cinema varies from once every other month to 14 screenings a week (or more). Cinema can be one function of many in a multipurpose venue or a stand-alone purpose-built venue. Cinema can be owned by the organisation or company that owns the venue or it can be a company who rents the venue (multi-purpose of stand-alone) for exhibition. Sources: https://tmgonline.nl/articles/10.18146/tmg.601 https://www.cinemahistories.org/projects/swedish-cinema-everyday-life/"}},{"id":"https://homernetwork.github.io/vocabulary/venues/Bioscope_theatre","prefLabel":{"en":"Bioscope theatre","nl":"bioscooptheater"},"altLabel":{"en":["Bioscope theatre"]},"definition":{"en":"Similar to cinematograph theatre but less common becasue bioscope did not become the most common word for projector. The London-based trade journal The Bioscope kept it in circulation."}},{"id":"https://homernetwork.github.io/vocabulary/venues/Cinema_theatre","prefLabel":{"en":"Cinema theatre","nl":"bioscoop","de":"Lichtspieltheater","it":"Sala cinematografica"},"altLabel":{"en":["Cinema house"],"nl":["bioscooptheater","cinema","filmtheater"],"de":["Kino"],"es":["Coliseum"]},"definition":{"en":"A building in which films were shown for a public that pays an entrance fee (so commercial cinema operations, in our data restricted to members of the national cinema union NBB)"},"narrower":[{"id":"https://homernetwork.github.io/vocabulary/venues/Kinematographentheater","prefLabel":{"en":"Kinematographentheater","de":"Kinematographentheater"},"definition":{"en":"Cinema theatre"},"scopeNote":{"en":["Historical term used for Cinema theatre"]}}]},{"id":"https://homernetwork.github.io/vocabulary/venues/Kinematographentheater","prefLabel":{"en":"Kinematographentheater","de":"Kinematographentheater"},"definition":{"en":"Cinema theatre"},"scopeNote":{"en":["Historical term used for Cinema theatre"]}},{"id":"https://homernetwork.github.io/vocabulary/venues/Cinematograph_theatre","prefLabel":{"en":"Cinematograph theatre"},"altLabel":{"en":["Cinematograph theatre"]},"definition":{"en":"Cinematograph was the term used for projector in official discourse in the UK/Ireland, such as in the Cinematograph Act, 1909, and the licences that were issued by urban councils on foot of it. As a result, the premises that focused on showing films using one of these devices were often officially referred to as cinematograph theatres."}},{"id":"https://homernetwork.github.io/vocabulary/venues/Commercial_building_converted_into_cinema","prefLabel":{"en":"Commercial building converted into cinema"},"altLabel":{"en":["Commercial building converted into cinema"]},"definition":{"en":"Commercial buildings converted into cinemas - shops, theatres, railway arches etc"}},{"id":"https://homernetwork.github.io/vocabulary/venues/Converted_premises","prefLabel":{"en":"Converted premises"},"altLabel":{"en":["Converted premises"]},"definition":{"en":"Commercial or otherwise premises adapted for film exhibition but which retained a connection to their previous use, often in the naming of the premises."}},{"id":"https://homernetwork.github.io/vocabulary/venues/Drive-in_cinema","prefLabel":{"en":"Drive-in cinema","nl":"drive-in bioscoop","de":"Autokino"},"altLabel":{"en":["Drive-in cinema"],"de":["Autokino"]},"definition":{"en":"Drive-ins are outdoor venues where audiences watch movies from their own vehicles. These locations provide all the necessary screening facilities for enjoying films."}},{"id":"https://homernetwork.github.io/vocabulary/venues/Electric_theatre","prefLabel":{"en":"Electric theatre"},"altLabel":{"en":["Electric theatre"]},"definition":{"en":"A company called Electric Theatres existed, but other unaffiliated proprietors referred to their premises as an electric theatre."}},{"id":"https://homernetwork.github.io/vocabulary/venues/Kinematograf_(venue)","prefLabel":{"en":"Kinematograf (venue)","de":"Kinematograf (venue)"},"altLabel":{"de":["Kinematograf (venue)"]},"definition":{"en":"The projection equipment and the term could also refer to the venue of film exhibition (used in the first decades of cinema)"}},{"id":"https://homernetwork.github.io/vocabulary/venues/Picture_House","prefLabel":{"en":"Picture House"},"altLabel":{"en":["Picture House"]},"definition":{"en":"in the early cinema period (1890s-c.1915), most things were in flux, and \"cinema\" was not the generic term for a premises exhibiting films; several other terms were used, the most common of which I have found in my research - which focuses on Ireland, still part of the UK at this time - was \"picture house\". But this was not a neutrally descriptive term; it and its alternatives often encoded class/commercial issues."}},{"id":"https://homernetwork.github.io/vocabulary/venues/Picture_palace","prefLabel":{"en":"Picture palace"},"altLabel":{"en":["Picture palace"]},"definition":{"en":"in certain contexts, this may have indicated a more salubrious venue than competitors or sometimes just the suggestion rather than the reality."}},{"id":"https://homernetwork.github.io/vocabulary/venues/Picture_theatre","prefLabel":{"en":"Picture theatre"},"altLabel":{"en":["Picture theatre"]},"definition":{"en":"Probably the second most common term in Ireland in the 1910s."}},{"id":"https://homernetwork.github.io/vocabulary/venues/Stand-alone_purpose-built_venue","prefLabel":{"en":"Stand-alone purpose-built venue"},"altLabel":{"en":["Stand-alone purpose-built venue"]},"definition":{"en":"An individual cinema that is based in a cinema dedicated venue"}},{"id":"https://homernetwork.github.io/vocabulary/venues/Theatre","prefLabel":{"en":"Theatre","de":"Varieté"},"altLabel":{"en":["Theatre"]},"definition":{"en":"Theatre - here referring not in the US synonym for cinema but to a theatre which mostly hosted live shows but showed films occasionally or in the case of variety theatres, incorporated film into its offerings on a regular basis for a substantial period (years), particularly if the proprietors had invested in a projector."},"narrower":[{"id":"https://homernetwork.github.io/vocabulary/venues/Mixed_programming_theatre_and_film","prefLabel":{"en":"Mixed programming theatre and film"},"altLabel":{"es":["Theatre and film"]}}]},{"id":"https://homernetwork.github.io/vocabulary/venues/Warehouse_building","prefLabel":{"en":"Warehouse building"},"altLabel":{"en":["Warehouse building"]},"definition":{"en":"Warehouse buildings taken over during the war. Viipuri during the Winter War, 1939-1940"}},{"id":"https://homernetwork.github.io/vocabulary/venues/Cinema","prefLabel":{"en":"Cinema","nl":"bioscoop","es":"Cines"},"altLabel":{"en":["Cinema"],"es":["Salas de Cine","Teatros"]},"definition":{"en":"A building where films were shown, not necessarily on a regular basis. It does not matter whether this was on a regular basis or not. Also a cinema can be an open air space (not a building) where a film is screened. This can be a square, a courtyard, a field. Cinema is \"\"an arrangement of things in space (including tools and information carriers); an arrangement of activity in time. Cf definition of Picture House"},"narrower":[{"id":"https://homernetwork.github.io/vocabulary/venues/niche_cinema","prefLabel":{"en":"niche cinema"},"definition":{"en":"specialty cinema"},"narrower":[{"id":"https://homernetwork.github.io/vocabulary/venues/Adult_cinema","prefLabel":{"en":"Adult cinema","nl":"Seksbioscoop"},"altLabel":{"en":["Sex cinema","x-rated cinema"],"nl":["Sexbioscoop"]},"definition":{"en":"Euphemistic term for a movie theater dedicated to the exhibition of pornographic films"},"narrower":[{"id":"https://homernetwork.github.io/vocabulary/venues/Porn_booth","prefLabel":{"en":"Porn booth"},"definition":{"en":"Booth inside an adult cinema"}},{"id":"https://homernetwork.github.io/vocabulary/venues/rural_open_air_cinema_where_3rd_film_is_adult","prefLabel":{"en":"rural open air cinema where 3rd film is adult"}}]}]},{"id":"https://homernetwork.github.io/vocabulary/venues/Single_screen_cinema","prefLabel":{"en":"Single screen cinema","it":"Monosala"},"definition":{"en":"Cinema with 1 screen."},"narrower":[{"id":"https://homernetwork.github.io/vocabulary/venues/sachelskino?","prefLabel":{"en":"sachelskino?"},"definition":{"en":"monoscteen 1k seats divided into multiple screens germ 70s"}},{"id":"https://homernetwork.github.io/vocabulary/venues/Grande_Salle","prefLabel":{"en":"Grande Salle","sv":"mono screen that maintained the original retro form;"},"definition":{"fr":"arianna"}}]},{"id":"https://homernetwork.github.io/vocabulary/venues/Mixed_programming_theatre_and_film","prefLabel":{"en":"Mixed programming theatre and film"},"altLabel":{"es":["Theatre and film"]}},{"id":"https://homernetwork.github.io/vocabulary/venues/ghost_cinema??","prefLabel":{"en":"ghost cinema??"},"definition":{"en":"Ivan: I think this came from Talitha, so I think this should be something like \"an abandoned cinema that remains in good condition\". Needs the correct PT term","fr":"(question answer)"},"scopeNote":{"en":["Brazil"]}},{"id":"https://homernetwork.github.io/vocabulary/venues/movie_hall","prefLabel":{"en":"movie hall"},"definition":{"fr":"François Beaurain- ENSA Paris la Villette)"}},{"id":"https://homernetwork.github.io/vocabulary/venues/permanent_cinema","prefLabel":{"en":"permanent cinema"}},{"id":"https://homernetwork.github.io/vocabulary/venues/commercial_cinema","prefLabel":{"en":"commercial cinema"}}]},{"id":"https://homernetwork.github.io/vocabulary/venues/Tent","prefLabel":{"en":"Tent","nl":"Tent"},"altLabel":{"en":["tent"]},"definition":{"en":"a portable shelter"}},{"id":"https://homernetwork.github.io/vocabulary/venues/Registered_cinema","prefLabel":{"en":"Registered cinema"},"definition":{"en":"A venue, that has been listed by film companies (also known as 'cinemas' in the Swedish industry records, ie Filmägarnas kontrollbyrå"}},{"id":"https://homernetwork.github.io/vocabulary/venues/Inbouwbioscoop","prefLabel":{"en":"Inbouwbioscoop"},"definition":{"en":"Dutch term for early multiplex cinemas, where in the existing single-screen cinema multiple extra screenings rooms were created."}}]},{"id":"https://homernetwork.github.io/vocabulary/venues/Private_venue","prefLabel":{"en":"Private venue","nl":"besloten ruimte"},"definition":{"en":"A venue that provides restricted access to certain groups of people"},"narrower":[{"id":"https://homernetwork.github.io/vocabulary/venues/Frontline_cinema","prefLabel":{"en":"Frontline cinema"},"altLabel":{"en":["Frontline cinema"]},"definition":{"en":"Finland: dugouts that were built for protection during the war (frontline cinema) Viipuri during the Winter War. To add: period"}},{"id":"https://homernetwork.github.io/vocabulary/venues/School","prefLabel":{"en":"School"},"altLabel":{"en":["School"]},"definition":{"en":"Indoor space for education where sometimes a film is shown"}},{"id":"https://homernetwork.github.io/vocabulary/venues/Club_house","prefLabel":{"en":"Club house","nl":"verenigingsgebouw"},"altLabel":{"en":["Club house"],"nl":["verenigingszaal"]},"definition":{"en":"Venue for meetings of labour associations, temperance groups, miners' institutes, sports and artistic clubs, drill halls, etc."}},{"id":"https://homernetwork.github.io/vocabulary/venues/Private_home","prefLabel":{"en":"Private home"},"altLabel":{"en":["Private home"]},"definition":{"en":"A private venue that offers occasional film screenings"}},{"id":"https://homernetwork.github.io/vocabulary/venues/artist_studios","prefLabel":{"en":"artist studios"},"definition":{"fr":"François Beaurain- ENSA Paris la Villette)"}}]},{"id":"https://homernetwork.github.io/vocabulary/venues/Venue_with_fixed_location","prefLabel":{"en":"Venue with fixed location"},"definition":{"en":"Geographically fixed (with a street address) building"},"narrower":[{"id":"https://homernetwork.github.io/vocabulary/venues/Warehouses","prefLabel":{"en":"Warehouses"},"altLabel":{"en":["Warehouses"]},"definition":{"en":"Cinemas are warehouse buildings taken over during the war. To add: period."}},{"id":"https://homernetwork.github.io/vocabulary/venues/Multiplex","prefLabel":{"en":"Multiplex","sv":"Filmstaden","it":"multisala"},"altLabel":{"en":["Multi-screen cinema"]},"definition":{"en":"A multiplex is a facility that accommodates multiple screens for the simultaneous screening of films."},"narrower":[{"id":"https://homernetwork.github.io/vocabulary/venues/Cityplex","prefLabel":{"en":"Cityplex"},"definition":{"en":"4-7 screens close to city centre"},"scopeNote":{"en":["Italy?"]}},{"id":"https://homernetwork.github.io/vocabulary/venues/Proto-multiplex","prefLabel":{"en":"Proto-multiplex"},"definition":{"en":"odeon cannon Roma or Milan?1986. includes food, shops etc, that stay open at night?"},"scopeNote":{"en":["Italy"]}},{"id":"https://homernetwork.github.io/vocabulary/venues/Italian_Multiplex","prefLabel":{"en":"Italian Multiplex"},"definition":{"en":"at least 8 screens, other measure activities that stay open till night (food, shops). eg Arcadia, Ostia"},"scopeNote":{"en":["Italy"]}},{"id":"https://homernetwork.github.io/vocabulary/venues/sachelskino?","prefLabel":{"en":"sachelskino?"},"definition":{"en":"monoscteen 1k seats divided into multiple screens germ 70s"}},{"id":"https://homernetwork.github.io/vocabulary/venues/inbouwbioscoop","prefLabel":{"en":"inbouwbioscoop"},"definition":{"en":"Een belangrijke ontwikkeling tenslotte is de inbouwbioscoop, die sinds 1971 sterk in\nopkomst is: grote bioscoopgebouwen worden opgesplitst in afzonderlijke zalen en zaaltjes,\nzodat er allerlei drie-in-een en vier-in-een theaters ontstaan.","fr":"thunnis, dibbets"}}]},{"id":"https://homernetwork.github.io/vocabulary/venues/Open-air","prefLabel":{"en":"Open-air","nl":"open lucht"},"altLabel":{"en":["Open-air"]},"definition":{"en":"It can be a square, a courtyard, a field. source: Europeancinemaaudiences.org"},"narrower":[{"id":"https://homernetwork.github.io/vocabulary/venues/Open-air_cinema","prefLabel":{"en":"Open-air cinema","nl":"openluchtbioscoop","sv":"Utomhusbio","es":"Terraza"},"altLabel":{"en":["Arena"]},"definition":{"en":"An open air or outdoor cinema, often temporary"},"narrower":[{"id":"https://homernetwork.github.io/vocabulary/venues/Drive-in_cinema","prefLabel":{"en":"Drive-in cinema","nl":"drive-in bioscoop","de":"Autokino"},"altLabel":{"en":["Drive-in cinema"],"de":["Autokino"]},"definition":{"en":"Drive-ins are outdoor venues where audiences watch movies from their own vehicles. These locations provide all the necessary screening facilities for enjoying films."}},{"id":"https://homernetwork.github.io/vocabulary/venues/cinema_with_retractable_roof","prefLabel":{"en":"cinema with retractable roof"},"definition":{"fr":"François Beaurain- ENSA Paris la Villette)"}}]}]},{"id":"https://homernetwork.github.io/vocabulary/venues/Biograf","prefLabel":{"en":"Biograf","sv":"Biograf"},"definition":{"en":"a venue, usually a building, for viewing films that has been listed by film companies (also known as 'cinemas' in the Swedish industry records, ie Filmägarnas kontrollbyrå) for more or less regular exhibition of film. It is a geographically fixed (with a street address) building. The frequency of film exhibition in a cinema varies from once every other month to 14 screenings a week (or more). Cinema can be one function of many in a multipurpose venue or a stand-alone purpose-built venue. Cinema can be owned by the organisation or company that owns the venue or it can be a company who rents the venue (multi-purpose of stand-alone) for exhibition. Sources: https://tmgonline.nl/articles/10.18146/tmg.601 https://www.cinemahistories.org/projects/swedish-cinema-everyday-life/"}},{"id":"https://homernetwork.github.io/vocabulary/venues/Club_house","prefLabel":{"en":"Club house","nl":"verenigingsgebouw"},"altLabel":{"en":["Club house"],"nl":["verenigingszaal"]},"definition":{"en":"Venue for meetings of labour associations, temperance groups, miners' institutes, sports and artistic clubs, drill halls, etc."}},{"id":"https://homernetwork.github.io/vocabulary/venues/Commercial_building_converted_into_cinema","prefLabel":{"en":"Commercial building converted into cinema"},"altLabel":{"en":["Commercial building converted into cinema"]},"definition":{"en":"Commercial buildings converted into cinemas - shops, theatres, railway arches etc"}},{"id":"https://homernetwork.github.io/vocabulary/venues/Converted_premises","prefLabel":{"en":"Converted premises"},"altLabel":{"en":["Converted premises"]},"definition":{"en":"Commercial or otherwise premises adapted for film exhibition but which retained a connection to their previous use, often in the naming of the premises."}},{"id":"https://homernetwork.github.io/vocabulary/venues/Drive-in_cinema","prefLabel":{"en":"Drive-in cinema","nl":"drive-in bioscoop","de":"Autokino"},"altLabel":{"en":["Drive-in cinema"],"de":["Autokino"]},"definition":{"en":"Drive-ins are outdoor venues where audiences watch movies from their own vehicles. These locations provide all the necessary screening facilities for enjoying films."}},{"id":"https://homernetwork.github.io/vocabulary/venues/Multipurpose_venue","prefLabel":{"en":"Multipurpose venue"},"altLabel":{"en":["Multipurpose venue"]},"definition":{"en":"The most important of these were town halls, often serving as the main film exhibition venue in smaller towns or villages.Church halls were also important but may have served only part of the local community."},"narrower":[{"id":"https://homernetwork.github.io/vocabulary/venues/School","prefLabel":{"en":"School"},"altLabel":{"en":["School"]},"definition":{"en":"Indoor space for education where sometimes a film is shown"}}]},{"id":"https://homernetwork.github.io/vocabulary/venues/Picture_House","prefLabel":{"en":"Picture House"},"altLabel":{"en":["Picture House"]},"definition":{"en":"in the early cinema period (1890s-c.1915), most things were in flux, and \"cinema\" was not the generic term for a premises exhibiting films; several other terms were used, the most common of which I have found in my research - which focuses on Ireland, still part of the UK at this time - was \"picture house\". But this was not a neutrally descriptive term; it and its alternatives often encoded class/commercial issues."}},{"id":"https://homernetwork.github.io/vocabulary/venues/Picture_palace","prefLabel":{"en":"Picture palace"},"altLabel":{"en":["Picture palace"]},"definition":{"en":"in certain contexts, this may have indicated a more salubrious venue than competitors or sometimes just the suggestion rather than the reality."}},{"id":"https://homernetwork.github.io/vocabulary/venues/Sala_cinematografica","prefLabel":{"en":"Sala cinematografica","it":"Sala cinematografica"},"altLabel":{"it":["Sala"]},"definition":{"en":"Every single place, usually a building, where a movie was shown. It could be a real movie theatre, a theatre, a cinema-theatre, a multipurpose venue, a building used for something else (e.g. hospital), an open-air cinema, etc. It is an address, usually, and correspond to specific geographic coordinates. The building, the management, the architecture, the name, etc., all can change, but it stays the same 'sala cinematografica' as long as it shows movies. Travelling cinemas are exluded for now. To account for moving exhibitors, societies etc, we have other categories (such as people and companies)."}},{"id":"https://homernetwork.github.io/vocabulary/venues/Stand-alone_purpose-built_venue","prefLabel":{"en":"Stand-alone purpose-built venue"},"altLabel":{"en":["Stand-alone purpose-built venue"]},"definition":{"en":"An individual cinema that is based in a cinema dedicated venue"}},{"id":"https://homernetwork.github.io/vocabulary/venues/Warehouse_building","prefLabel":{"en":"Warehouse building"},"altLabel":{"en":["Warehouse building"]},"definition":{"en":"Warehouse buildings taken over during the war. Viipuri during the Winter War, 1939-1940"}},{"id":"https://homernetwork.github.io/vocabulary/venues/Inbouwbioscoop","prefLabel":{"en":"Inbouwbioscoop"},"definition":{"en":"Dutch term for early multiplex cinemas, where in the existing single-screen cinema multiple extra screenings rooms were created."}}]},{"id":"https://homernetwork.github.io/vocabulary/venues/Travelling_venue","prefLabel":{"en":"Travelling venue","nl":"reisbioscoop"},"altLabel":{"nl":["reizende bioscoop","mobiele filmexploitatie"]},"definition":{"en":"Mobile venue."},"narrower":[{"id":"https://homernetwork.github.io/vocabulary/venues/Travelling_cinema","prefLabel":{"en":"Travelling cinema","nl":"reisbioscoop","de":"Wanderkino"},"altLabel":{"en":["Travelling cinema"],"nl":["reizende bioscoop"]},"definition":{"en":"A temporary setup for screening films to an audience at a venue that is not a purpose built building (e.g., fairs, community halls, etc.)"},"narrower":[{"id":"https://homernetwork.github.io/vocabulary/venues/traveling_theatres","prefLabel":{"en":"traveling theatres"},"definition":{"fr":"Serkan Şavk, Aydın Çam"}},{"id":"https://homernetwork.github.io/vocabulary/venues/mobile_cinemas","prefLabel":{"en":"mobile cinemas"},"definition":{"fr":"Foteini Klini"},"narrower":[{"id":"https://homernetwork.github.io/vocabulary/venues/mobile_cinema_vans_(partial_venue?)","prefLabel":{"en":"mobile cinema vans (partial venue?)"}},{"id":"https://homernetwork.github.io/vocabulary/venues/mule_drawn_cart_(partial)","prefLabel":{"en":"mule drawn cart (partial)"}}]}]}]},{"id":"https://homernetwork.github.io/vocabulary/venues/Virtual_Venue","prefLabel":{"en":"Virtual Venue"},"altLabel":{"en":["Virtual Venue"]},"definition":{"en":"Online spaces for viewing digital audiovisual content. Viewers can access them through various screens at their convenience, choosing the time and mode of consumption."},"narrower":[{"id":"https://homernetwork.github.io/vocabulary/venues/Streaming_Platform","prefLabel":{"en":"Streaming Platform"},"altLabel":{"en":["Streaming Platform"]},"definition":{"en":"on-demand online entertainment sources for TV shows, movies, and other streaming media"}}]},{"id":"https://homernetwork.github.io/vocabulary/venues/Single_purpose_venue","prefLabel":{"en":"Single purpose venue"},"definition":{"en":"A venue specifically dedicated to one activity"}},{"id":"https://homernetwork.github.io/vocabulary/venues/Teatro","prefLabel":{"en":"Teatro","es":"Teatro"},"definition":{"en":"In Latin America the word \"teatro\" is mostly used for live entertainment events and \"cine\" for film screenings, unlike American English which tend to use \"theatre\" also for movie venue"}},{"id":"https://homernetwork.github.io/vocabulary/venues/Saal","prefLabel":{"en":"Saal","nl":"zaal"},"definition":{"en":"\"Saal\" as defined in the Early German Film Database: not a Kino, not a theatre and not a traveling cinema"}},{"id":"https://homernetwork.github.io/vocabulary/venues/venue_by_location","prefLabel":{"en":"venue by location"},"narrower":[{"id":"https://homernetwork.github.io/vocabulary/venues/rural_open_air_cinema_where_3rd_film_is_adult","prefLabel":{"en":"rural open air cinema where 3rd film is adult"}},{"id":"https://homernetwork.github.io/vocabulary/venues/urban_cinema","prefLabel":{"en":"urban cinema"},"definition":{"en":"Denmark 40-45, cf Nordisk julie"}},{"id":"https://homernetwork.github.io/vocabulary/venues/rural_cinema","prefLabel":{"en":"rural cinema"},"definition":{"en":"kulie"}},{"id":"https://homernetwork.github.io/vocabulary/venues/suburban_cinema","prefLabel":{"en":"suburban cinema"},"definition":{"en":"from Talitha - cinema in a suburban area","fr":"Talitha Ferraz"}},{"id":"https://homernetwork.github.io/vocabulary/venues/favela_cinema","prefLabel":{"en":"favela cinema"},"definition":{"en":"from Talitha - cinema in a favela","fr":"Talitha Ferraz"},"scopeNote":{"en":["Brazil"]}},{"id":"https://homernetwork.github.io/vocabulary/venues/station_cınema","prefLabel":{"en":"station cınema"},"definition":{"en":"from Clara, this should be a cinema in a train station","fr":"clara"}}]},{"id":"https://homernetwork.github.io/vocabulary/venues/venue_by_audience_type","prefLabel":{"en":"venue by audience type"},"narrower":[{"id":"https://homernetwork.github.io/vocabulary/venues/counterculture","prefLabel":{"en":"counterculture"},"definition":{"en":"eg Electric cinema, London"}},{"id":"https://homernetwork.github.io/vocabulary/venues/underground_cinema","prefLabel":{"en":"underground cinema"},"definition":{"en":"‘Underground’ is a label applied to the outer fringes of the radical film spectrum: films whose form, subject matter, or both, challenge conventional cinematic habits.","fr":"Aynülhayat Uybadın"}},{"id":"https://homernetwork.github.io/vocabulary/venues/brown-skinned_or_black","prefLabel":{"en":"brown-skinned or black"},"definition":{"en":"from Talitha","fr":"Talitha Ferraz"}}]},{"id":"https://homernetwork.github.io/vocabulary/venues/venue_by_cleanliness","prefLabel":{"en":"venue by cleanliness"},"narrower":[{"id":"https://homernetwork.github.io/vocabulary/venues/Dirty_cinema","prefLabel":{"en":"Dirty cinema","sv":"pidocchietto"},"altLabel":{"en":["fleapit cinema"]},"definition":{"en":"Has actual dirt on the floor"}}]},{"id":"https://homernetwork.github.io/vocabulary/venues/venue_by_equipment","prefLabel":{"en":"venue by equipment"},"narrower":[{"id":"https://homernetwork.github.io/vocabulary/venues/VR_cinema","prefLabel":{"en":"VR cinema"}},{"id":"https://homernetwork.github.io/vocabulary/venues/3d/VR","prefLabel":{"en":"3d/VR"}},{"id":"https://homernetwork.github.io/vocabulary/venues/2d","prefLabel":{"en":"2d"}},{"id":"https://homernetwork.github.io/vocabulary/venues/Grande_Salle","prefLabel":{"en":"Grande Salle","sv":"mono screen that maintained the original retro form;"},"definition":{"fr":"arianna"}},{"id":"https://homernetwork.github.io/vocabulary/venues/High-tech_monosala","prefLabel":{"en":"High-tech monosala","sv":"with a best projection system."},"definition":{"fr":"arianna"}},{"id":"https://homernetwork.github.io/vocabulary/venues/sound_cinema","prefLabel":{"en":"sound cinema"},"definition":{"en":"not a silent cinema","fr":"Morgan Corriou"}},{"id":"https://homernetwork.github.io/vocabulary/venues/standard_gauge_(35mm)","prefLabel":{"en":"standard gauge (35mm)"}}]},{"id":"https://homernetwork.github.io/vocabulary/venues/venue_by_size","prefLabel":{"en":"venue by size"},"narrower":[{"id":"https://homernetwork.github.io/vocabulary/venues/sachelskino?","prefLabel":{"en":"sachelskino?"},"definition":{"en":"monoscteen 1k seats divided into multiple screens germ 70s"}}]},{"id":"https://homernetwork.github.io/vocabulary/venues/venue_by_official_status","prefLabel":{"en":"venue by official status"},"narrower":[{"id":"https://homernetwork.github.io/vocabulary/venues/ghost_cinema","prefLabel":{"en":"ghost cinema"},"definition":{"en":"not an official cinema, Tamil?"}}]},{"id":"https://homernetwork.github.io/vocabulary/venues/venue_by_purpose_of_screening","prefLabel":{"en":"venue by purpose of screening"},"narrower":[{"id":"https://homernetwork.github.io/vocabulary/venues/news","prefLabel":{"en":"news"},"definition":{"en":"daniela"}},{"id":"https://homernetwork.g