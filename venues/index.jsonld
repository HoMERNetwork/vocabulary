tion":{"en":"Cinema specialised in the screening of newsreels"}},{"id":"https://homernetwork.github.io/vocabulary/venues/Mixed_programming_theatre_and_film","prefLabel":{"en":"Mixed programming theatre and film"},"altLabel":{"es":["Theatre and film"]}},{"id":"https://homernetwork.github.io/vocabulary/venues/Repertory_cinema","prefLabel":{"en":"Repertory cinema"},"definition":{"en":"Venue which mainly programmes films out of regular distribution, such as significantly older films and 'classics'"}},{"id":"https://homernetwork.github.io/vocabulary/venues/counterculture","prefLabel":{"en":"counterculture"},"definition":{"en":"eg Electric cinema, London"}},{"id":"https://homernetwork.github.io/vocabulary/venues/Grindhouse_cinema","prefLabel":{"en":"Grindhouse cinema"},"definition":{"en":"eg Scala, London. Also shows porn and illegal films. Nickel cinema also example"}},{"id":"https://homernetwork.github.io/vocabulary/venues/underground_cinema","prefLabel":{"en":"underground cinema"},"definition":{"en":"‘Underground’ is a label applied to the outer fringes of the radical film spectrum: films whose form, subject matter, or both, challenge conventional cinematic habits.","fr":"Aynülhayat Uybadın"}}]},{"id":"https://homernetwork.github.io/vocabulary/venues/Venue_by_ownership","prefLabel":{"en":"Venue by ownership"},"narrower":[{"id":"https://homernetwork.github.io/vocabulary/venues/Cinema_chain","prefLabel":{"en":"Cinema chain","nl":"bioscoopketen"},"definition":{"en":"Series of cinemas owned by a single owner or company."}},{"id":"https://homernetwork.github.io/vocabulary/venues/Independent","prefLabel":{"en":"Independent","nl":"onafhankelijk"},"definition":{"en":"Cinema ownership that is independant of large (integrated) cinema chains."}},{"id":"https://homernetwork.github.io/vocabulary/venues/Single_venue","prefLabel":{"en":"Single venue"},"definition":{"en":"A cinema not part of chain of cinemas either horizontally or vertically integrated companies"}},{"id":"https://homernetwork.github.io/vocabulary/venues/Dependent","prefLabel":{"en":"Dependent"},"narrower":[{"id":"https://homernetwork.github.io/vocabulary/venues/Franchise","prefLabel":{"en":"Franchise"},"definition":{"en":"an authorization granted by a government or company to an individual or group enabling them to carry out specified commercial activities, for example acting as an agent for a company's products"}},{"id":"https://homernetwork.github.io/vocabulary/venues/Vertically_integrated_company","prefLabel":{"en":"Vertically integrated company"},"definition":{"en":"Ownership of two or more branches in a company's supply chain, in the case of cinema this usually means control of at least 2 of 3 areas: exhibition, distribution and production"}}]}]},{"id":"https://homernetwork.github.io/vocabulary/venues/Venue_by_opening_type","prefLabel":{"en":"Venue by opening type"},"narrower":[{"id":"https://homernetwork.github.io/vocabulary/venues/Seasonal","prefLabel":{"en":"Seasonal","nl":"seizoensgebonden"},"definition":{"en":"fluctuating or restricted according to the season or time of year."},"narrower":[{"id":"https://homernetwork.github.io/vocabulary/venues/summer_cinema","prefLabel":{"en":"summer cinema"},"definition":{"en":"cinema operating in summer?","fr":"Aydın Çam, Çiğdem Aksu Çam"}},{"id":"https://homernetwork.github.io/vocabulary/venues/winter_cinema","prefLabel":{"en":"winter cinema"},"definition":{"en":"cinema operating in winter?","fr":"daniela"}}]},{"id":"https://homernetwork.github.io/vocabulary/venues/Year-round","prefLabel":{"en":"Year-round"},"definition":{"en":"operational throughout the year"}}]},{"id":"https://homernetwork.github.io/vocabulary/venues/Venues_by_category","prefLabel":{"en":"Venues by category"},"narrower":[{"id":"https://homernetwork.github.io/vocabulary/venues/Tier","prefLabel":{"en":"Tier"},"narrower":[{"id":"https://homernetwork.github.io/vocabulary/venues/First_run","prefLabel":{"en":"First run"},"definition":{"en":"Cinema specialised in screening premiere films, available for public viewing for the first time in a certain geographical area"}},{"id":"https://homernetwork.github.io/vocabulary/venues/Second_run","prefLabel":{"en":"Second run"},"definition":{"en":"Cinema specialised in screening films for a second 'run', after the film has previously been screened for its first run in a different cinema in the same geographical area (city)."}}]},{"id":"https://homernetwork.github.io/vocabulary/venues/ECA-Rank","prefLabel":{"en":"ECA-Rank"},"narrower":[{"id":"https://homernetwork.github.io/vocabulary/venues/Intermediate","prefLabel":{"en":"Intermediate"}},{"id":"https://homernetwork.github.io/vocabulary/venues/Elite","prefLabel":{"en":"Elite"}},{"id":"https://homernetwork.github.io/vocabulary/venues/Minor","prefLabel":{"en":"Minor"}},{"id":"https://homernetwork.github.io/vocabulary/venues/Inactive","prefLabel":{"en":"Inactive"}},{"id":"https://homernetwork.github.io/vocabulary/venues/Major","prefLabel":{"en":"Major"}}]},{"id":"https://homernetwork.github.io/vocabulary/venues/Category","prefLabel":{"en":"Category","de":"Category"},"definition":{"en":"(defined by Italian, UK or US authorities and pertains to the 'tier' of the cinema)"}},{"id":"https://homernetwork.github.io/vocabulary/venues/premiere_cinema","prefLabel":{"en":"premiere cinema"},"definition":{"en":"julie"}}]},{"id":"https://homernetwork.github.io/vocabulary/venues/venue_part","prefLabel":{"en":"venue part"},"definition":{"en":"part of a venue. Could rooms go in here?"},"narrower":[{"id":"https://homernetwork.github.io/vocabulary/venues/Zaal","prefLabel":{"en":"Zaal"},"definition":{"en":"ivan: iirc, a room that is part of a building where the room is used as a cinema but the building itself has a different purpose."}},{"id":"https://homernetwork.github.io/vocabulary/venues/video_booth","prefLabel":{"en":"video booth"},"narrower":[{"id":"https://homernetwork.github.io/vocabulary/venues/Porn_booth","prefLabel":{"en":"Porn booth"},"definition":{"en